{
  "Ai": {
    "Provider": "Development",
    "Model": "development-assistant",
    "MaxContextCharacters": 32000
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=CollaborativeCodingDb;Username=postgres;Password=1234",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "Coding.Api",
    "Audience": "Coding.Frontend",
    "Key": "change-this-development-key-before-production-123456",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Coding.Api"
    }
  },
  "AllowedHosts": "*"
}
