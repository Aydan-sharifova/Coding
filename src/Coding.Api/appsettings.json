{
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Coding",
    "ClientBaseUrl": "http://localhost:5173"
  },
  "ConnectionStrings": {
    "Default": "",
    "Redis": "localhost:6379"
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-5.6-sol",
    "BaseUrl": "https://api.openai.com/v1/",
    "MaxOutputTokens": 4096
  },
  "Jwt": {
      "Issuer": "Coding.Api",
      "Audience": "Coding.Frontend",
      "Key": "",
      "AccessTokenMinutes": 15
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:5173"
      ]
    },
    "Database": {
      "ApplyMigrations": false
    },
    "Serilog": {
      "Using": [
        "Serilog.Sinks.Console"
      ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.Hosting.Lifetime": "Information",
          "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      ],
      "Enrich": [
        "FromLogContext",
        "WithMachineName",
        "WithThreadId"
      ],
      "Properties": {
        "Application": "Coding.Api"
      }
  },
  "AllowedHosts": "*"
}
