{
  "Database": {
    "ApplyMigrations": false,
    "SeedDevelopmentData": false
  },
  "DemoMode": {
    "Enabled": true,
    "DatabaseNameMarker": "Demo",
    "AccessTokenMinutes": 20,
    "RefreshTokenHours": 2,
    "ResetIntervalMinutes": 60,
    "MaxUploadBytes": 1048576
  },
  "AI": {
    "Provider": "Ollama"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Properties": {
      "Environment": "Demo"
    }
  }
}
